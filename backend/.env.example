# PostgreSQL is the supported application database. SQLite remains available
# only for local automated tests and legacy data-export work.
DATABASE_URL=postgresql+psycopg://cargomatiq:cargomatiq@localhost:5432/cargomatiq
STORAGE_DIR=./storage

# Optional IMAP mailbox. These are read during startup; the mailbox cursor is
# stored in PostgreSQL. For Gmail use a newly generated App Password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=ops@example.com
IMAP_PASSWORD=replace-with-app-password
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=60
